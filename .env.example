# Meta WhatsApp Cloud API
META_PHONE_NUMBER_ID=951110871409846
META_ACCESS_TOKEN=your_new_token_after_rotation
# WhatsApp Business Account id — required for cost (/cost) sync.
# WhatsApp Manager → Configurações da conta → "ID da conta do WhatsApp Business"
META_WABA_ID=25186083634334669

# Supabase
SUPABASE_URL=https://tzqjezbsysetkmzxpuet.supabase.co
SUPABASE_KEY=your_service_role_key

# Scheduler poll interval in seconds (default: 30)
SCHEDULER_INTERVAL_SECONDS=30
SCHEDULER_BATCH_SIZE=50

# Retry policy for transient send failures
MESSAGE_MAX_ATTEMPTS=3
MESSAGE_RETRY_BASE_MINUTES=5

# Cost sync (Meta pricing_analytics)
COST_SYNC_INTERVAL_SECONDS=86400
COST_SYNC_LOOKBACK_DAYS=7

# Webhook signature verification (opt-in — leave empty to accept all webhooks).
# Set these only after confirming the signing scheme with each platform.
KIWIFY_WEBHOOK_TOKEN=
ASSINY_WEBHOOK_TOKEN=
